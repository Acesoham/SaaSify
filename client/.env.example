# ─── SaaSify Client — Environment Variables Example ──────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.

# ── API / Socket ─────────────────────────────────────────────────────────────
# Only required if you are NOT using the Vite dev-server proxy.
# In dev mode the proxy in vite.config.js routes /api and /socket.io → the server.
# In production, set this to your deployed API origin (no trailing slash).
VITE_API_URL=
