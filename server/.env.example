# ─── Core ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/saasify

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# ─── Client ──────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Redis / Queue ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── GitHub OAuth App ────────────────────────────────────────────────────────
# Create at: https://github.com/settings/developers → OAuth Apps → New
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
# Callback URL must match exactly what you set on GitHub
GITHUB_CALLBACK_URL=http://localhost:5000/api/github/callback
# Used for webhook HMAC verification — generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# ─── Google OAuth App ────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ─── Docker ──────────────────────────────────────────────────────────────────
DOCKER_SOCKET=/var/run/docker.sock
DEPLOY_DIR=/tmp/saasify-deployments
DOCKER_NETWORK=saasify-apps

# ─── Nginx ───────────────────────────────────────────────────────────────────
NGINX_CONFIG_DIR=/etc/nginx/conf.d
NGINX_TEMPLATE_DIR=./src/nginx/templates

# ─── Deployment Port Allocator ───────────────────────────────────────────────
PORT_RANGE_START=4000
PORT_RANGE_END=5999
BASE_DOMAIN=localhost
# Port your deployed apps listen on inside their container (usually 3000 or 8080)
APP_CONTAINER_PORT=3000

# ─── Encryption (AES-256-GCM for env var storage) ────────────────────────────
# Must be exactly 32 characters — generate with: openssl rand -hex 16
ENCRYPTION_KEY=saasify-32-char-encryption-key!!
